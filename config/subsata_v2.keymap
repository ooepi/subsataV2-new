#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        td: td {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&kp ESC>, <&kp RET>;
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <360>;
            bindings = <&kp>, <&kp>;
        };

        mm: mm {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp COMMA>, <&kp SEMI>;
        };

        rot: rot {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
    };

    macros {
        macro: macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            // | ESC   | F1   | F2 |     | F3 | F4 | F5 |   | F6  | F7 | F8 |   | F9 | F10   | F11 | F12  | PSCRN | DEL   |       | HOME   | END         |          | C_MUTE   |
            // | `     | 1    | 2  |     | 3  | 4  | 5  |   | 6   | 7  | 8  |   | 9  | 0     | -   | =    |       | BSPC  |       | KP_NUM | KP_MULTIPLY | KP_SLASH | KP_MINUS |
            // | TAB   |      | Q  | W   | E  |    | R  | T | Y   |    | U  | I | O  |       | P   | [    | ]     | ENTER |       | KP_N7  | KP_N8       | KP_N9    | KP_PLUS  |
            // | CAPS  |      | A  | S   |    | D  | F  | G |     | H  | J  | K |    | L     | ;   | '    | BSLH  |               | KP_N4  | KP_N5       | KP_N6    |
            // | SHIFT | BSLH |    | Z   | X  | C  |    | V | B   | N  |    | M | ,  | .     |     | FSLH | SHIFT | UP    |       | KP_N1  | KP_N2       | KP_N3    | KP_ENTER |
            // | CTRL  | GUI  |    | ALT |                  | SPC |                  | ALTGR | UP  | CTRL | LEFT  | DOWN  |       | KP_N0  |             | KP_COMMA |
            //                                                                                                            | RIGHT |
            bindings = <
                &kp ESC    &kp F1    &kp F2            &kp F3  &kp F4  &kp F5         &kp F6     &kp F7  &kp F8         &kp F9     &kp F10   &kp F11    &kp F12    &kp PSCRN  &kp DEL              &kp HOME    &kp END                        &kp C_MUTE
                &kp GRAVE  &kp N1    &kp N2            &kp N3  &kp N4  &kp N5         &kp N6     &kp N7  &kp N8         &kp N9     &kp N0    &kp MINUS  &kp EQUAL             &kp BSPC             &kp KP_NUM  &kp KP_MULTIPLY  &kp KP_SLASH  &kp KP_MINUS
                &kp TAB              &kp Q   &kp W     &kp E           &kp R   &kp T  &kp Y              &kp U   &kp I  &kp O                &kp P      &kp LBKT   &kp RBKT   &kp RET              &kp KP_N7   &kp KP_N8        &kp KP_N9     &kp KP_PLUS
                &kp CAPS             &kp A   &kp S             &kp D   &kp F   &kp G             &kp H   &kp J   &kp K             &kp L     &kp SEMI   &kp SQT    &kp BSLH                        &kp KP_N4   &kp KP_N5        &kp KP_N6
                &kp LSHFT  &kp BSLH          &kp Z     &kp X   &kp C           &kp V  &kp B      &kp N           &kp M  &kp COMMA  &kp DOT              &kp FSLH   &kp RSHFT  &kp UP               &kp KP_N1   &kp KP_N2        &kp KP_N3     &kp KP_ENTER
                &kp LCTRL  &kp LGUI          &kp LALT                                 &kp SPACE                                    &kp RALT  &mo 1      &kp RCTRL  &kp LEFT   &kp DOWN             &kp KP_N0                    &kp KP_COMMA
                                                                                                                                                                                        &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        up {
            display-name = "UP";
            // | BTCLR | BT1 | BT2 |   | BT3 |   |   |   |   |   |   |   |   | RGB_UG RGB_TOG | RGB_UG RGB_BRD | RGB_UG RGB_BRI | RGB_UG RGB_EFF |   |   | PREV | NEXT |   |   |
            // |       |     |     |   |     |   |   |   |   |   |   |   |   |                | RGB_UG RGB_HUD | RGB_UG RGB_HUI |                |   |   | PLAY |      |   |   |
            // |       |     |     |   |     |   |   |   |   |   |   |   |   |                |                | RGB_UG RGB_SAD | RGB_UG RGB_SAI |   |   |      |      |   |   |
            // |       |     |     |   |     |   |   |   |   |   |   |   |   |                |                |                |                |       |      |      |   |
            // |       |     |     |   |     |   |   |   |   |   |   |   |   |                |                |                |                |   |   |      |      |   |   |
            // |       |     |     |   |                 |   |               |                |                |                |                |   |   |      |      |   |
            //                                                                                                                                       |   |
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2  &trans  &trans          &trans  &trans  &trans          &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_EFF  &trans          &kp C_PREV  &kp C_NEXT          &trans
                &trans      &trans        &trans                &trans        &trans  &trans          &trans  &trans  &trans          &trans  &trans           &rgb_ug RGB_HUD  &rgb_ug RGB_HUI                   &trans          &kp C_PP    &trans      &trans  &trans
                &trans                    &trans        &trans  &trans                &trans  &trans  &trans          &trans  &trans  &trans                   &trans           &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans          &trans      &trans      &trans  &trans
                &trans                    &trans        &trans                &trans  &trans  &trans          &trans  &trans  &trans          &trans           &trans           &trans           &trans                           &trans      &trans      &trans
                &trans      &trans                      &trans  &trans        &trans          &trans  &trans  &trans          &trans  &trans  &trans                            &trans           &trans           &trans          &trans      &trans      &trans  &trans
                &trans      &trans                      &trans                                        &trans                                  &trans           &trans           &trans           &trans           &trans          &trans                  &trans
                                                                                                                                                                                                                          &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };
    };
};
